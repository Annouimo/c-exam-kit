{
  "version": "0.5.0",
  "modules": {
    "core": {
      "template": "core.c",
      "requires": [],
      "description": "内存与容量检查（自动依赖）"
    },
    "string": {
      "template": "string.c",
      "requires": [
        "core"
      ],
      "description": "动态字符串、编辑、分割与连接",
      "extra_templates": [
        "string_extra.c",
        "string_format.c",
        "string_list.c",
        "string_objects.c"
      ]
    },
    "vector": {
      "template": "vector.c",
      "requires": [
        "core"
      ],
      "description": "按实际 C 类型生成动态数组",
      "extra_templates": [
        "vector_extra.c",
        "vector_functional.c"
      ],
      "numeric_templates": {
        "int": [
          "vector_numeric.c",
          "vector_sum_integer.c",
          "vector_range.c"
        ],
        "long long": [
          "vector_numeric.c",
          "vector_sum_integer.c",
          "vector_range.c"
        ],
        "double": [
          "vector_numeric.c",
          "vector_sum_real.c"
        ]
      }
    },
    "map": {
      "template": "map.c",
      "requires": [
        "string"
      ],
      "description": "字符串键 → long long 哈希映射"
    },
    "set": {
      "template": "set.c",
      "requires": [
        "map"
      ],
      "description": "字符串集合"
    },
    "counter": {
      "template": "counter.c",
      "requires": [
        "map"
      ],
      "description": "字符串频次统计"
    },
    "deque": {
      "template": "deque.c",
      "requires": [
        "core"
      ],
      "description": "类型化双端队列（队列与栈）"
    },
    "heap": {
      "template": "heap.c",
      "requires": [
        "core"
      ],
      "description": "类型化优先队列（比较器决定优先级）"
    },
    "io": {
      "template": "io.c",
      "requires": [
        "string",
        "vector"
      ],
      "post_containers": true,
      "description": "默认跳过空白、raw 精确读取、数值验证与批量输出"
    }
  }
}
